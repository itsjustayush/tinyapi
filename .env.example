# MeteorBase production configuration
# Never commit a real .env file.

# Supabase project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated
# Optional issuer validation, e.g. https://your-project.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=

# Shared trust boundary between MeteorBase and every registered microservice.
INTERNAL_SECRET=replace-with-a-long-random-secret

# Canonical public origin used in docs and OAuth redirects.
PUBLIC_BASE_URL=https://tinyapi-urjr.onrender.com

# Runtime guardrails
RATE_LIMIT_PER_MINUTE=120
PROXY_TIMEOUT_SECONDS=15
MAX_REQUEST_BYTES=2097152
API_KEY_PREFIX=mb_live_
