# ============================================================
# MeteorBase - Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git (it is already gitignored).
# ============================================================

# Supabase project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=

# Public anon key (used by the browser dashboard / auth pages)
SUPABASE_ANON_KEY=

# SECRET service_role key (used by the gateway server itself).
# Must be the service_role key - NOT the anon key - so the server
# can read webhook_secret and write logs/heartbeats.
SUPABASE_SERVICE_KEY=

# JWT secret for the Supabase project (Settings > API > JWT Secret).
# Used to validate browser JWTs server-side for the admin API.
SUPABASE_JWT_SECRET=

# Random shared secret that ALL of your child apps must know.
# MeteorBase sends it as the X-Internal-Secret header so each app
# can verify a request really came from MeteorBase.
INTERNAL_SECRET=

# Optional: throttle each API key (default 120 req/min)
# RATE_LIMIT_PER_MINUTE=120